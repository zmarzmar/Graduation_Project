OPENAI_API_KEY=replace_me
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=you@example.com
CORS_ORIGINS=http://localhost:3000,https://paperpilot.cloud,https://www.paperpilot.cloud
# 반드시 긴 랜덤 문자열로 교체할 것 — 기본값/빈값이면 앱 startup이 실패한다
JWT_SECRET_KEY=replace_with_long_random_string
# PDF 업로드 상한 (바이트) — 기본 20MB
MAX_PDF_UPLOAD_BYTES=20971520
# 개발/초기 설정용 seed 값 — 운영 적용 후에는 제거하거나 실행하지 않는다
SEED_ADMIN_EMAIL=admin@paperpilot.local
SEED_ADMIN_PASSWORD=change-this-admin-password
# 테스트 유저는 필요할 때만 설정한다. 미설정 시 seed.py가 생성하지 않는다
# SEED_TEST_EMAIL=test@example.com
# SEED_TEST_PASSWORD=change-this-test-password
# SEED_TEST_USERNAME=testuser
# SEED_TEST_FULLNAME=Test User
# SEED_TEST_AFFILIATION=
